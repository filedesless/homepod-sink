# Copy to ~/.config/homepod-sink/homepod-sink.env and fill in your HomePod's
# IP (or name). Leave both HOMEPOD_IP and HOMEPOD_NAME unset/commented out to
# rely on auto-discovery instead — only reliable if exactly one AirPlay
# device is ever on the network, since nothing here can resolve an ambiguous
# list interactively.

HOMEPOD_IP=192.168.0.13
# HOMEPOD_NAME=Living Room
# HOMEPOD_SINK_NAME=HomePod
# HOMEPOD_PORT=7000
# HOMEPOD_SAMPLE_RATE=48000
