# Maintainer: filedesless <filedesless@gmail.com>
#
# Prebuilt binaries from the rolling "latest" GitHub release, which CI
# rebuilds on every push to master. Nothing here is bumped per release:
# pkgver and the checksums come from the release's `manifest` asset
# (scripts/manifest.sh), looked up whenever this file is evaluated - and
# paru re-evaluates it (GenerateSrcinfo) on every refresh, so `paru -Syu`
# sees each new build without a commit. That network lookup is fine for a
# PKGBUILD repo but not allowed on the AUR.

# Fetched once per build: makepkg re-sources this file (e.g. under
# fakeroot), and a release landing mid-build mustn't change pkgver between
# downloading and packaging. Parsed field by field, never eval'd. Offline
# or on a malformed manifest, pkgver falls back to r0 (with SKIP sums, so
# the file still evaluates): paru sees no update, and r0 can't be built.
_release=https://github.com/filedesless/homepod-sink/releases/download/latest
export _HOMEPOD_SINK_MANIFEST="${_HOMEPOD_SINK_MANIFEST-$(curl -fsSL --max-time 20 "$_release/manifest" 2>/dev/null)}"
_manifest_field() { sed -n "s/^$1=\($2\)\$/\1/p" <<<"$_HOMEPOD_SINK_MANIFEST"; }
_manifest_pkgver=$(_manifest_field pkgver 'r[0-9]\+\.[0-9a-f]\+')
_manifest_sha256_x86_64=$(_manifest_field sha256_x86_64 '[0-9a-f]\{64\}')
_manifest_sha256_aarch64=$(_manifest_field sha256_aarch64 '[0-9a-f]\{64\}')
if [[ -z $_manifest_pkgver || -z $_manifest_sha256_x86_64 || -z $_manifest_sha256_aarch64 ]]; then
    _manifest_pkgver=r0.0000000 _manifest_sha256_x86_64=SKIP _manifest_sha256_aarch64=SKIP
fi

pkgname=homepod-sink-nightly
pkgver=$_manifest_pkgver
pkgrel=1
pkgdesc="Turns a HomePod into a PipeWire audio output via AirPlay 2 (prebuilt from master)"
arch=('x86_64' 'aarch64')
url="https://github.com/filedesless/homepod-sink"
license=('GPL-3.0-or-later')
depends=('pipewire' 'gcc-libs' 'glibc')
provides=('homepod-sink')
conflicts=('homepod-sink')
backup=('etc/homepod-sink/homepod-sink.env.example' 'etc/ufw/applications.d/homepod-sink')
options=('!debug' '!strip')
install=homepod-sink.install
source_x86_64=("$_release/homepod-sink-$pkgver-x86_64.tar.gz")
source_aarch64=("$_release/homepod-sink-$pkgver-aarch64.tar.gz")
sha256sums_x86_64=("$_manifest_sha256_x86_64")
sha256sums_aarch64=("$_manifest_sha256_aarch64")

package() {
    cd "$srcdir/homepod-sink-$pkgver-$CARCH"

    install -Dm755 homepod-sink "$pkgdir/usr/lib/homepod-sink/homepod-sink"
    install -Dm755 play "$pkgdir/usr/lib/homepod-sink/play"
    install -Dm755 run.sh "$pkgdir/usr/lib/homepod-sink/run.sh"

    install -Dm644 homepod-sink.service \
        "$pkgdir/usr/lib/systemd/user/homepod-sink.service"
    install -Dm644 homepod-sink.env.example \
        "$pkgdir/etc/homepod-sink/homepod-sink.env.example"

    install -Dm644 homepod-sink.ufw "$pkgdir/etc/ufw/applications.d/homepod-sink"
    install -Dm644 homepod-sink.xml \
        "$pkgdir/usr/lib/firewalld/services/homepod-sink.xml"

    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
