apply_setcap() {
    setcap cap_sys_nice+ep /usr/lib/homepod-sink/homepod-sink || \
        echo "==> WARNING: setcap cap_sys_nice+ep failed - homepod-sink will run without real-time scheduling."
}

post_install() {
    apply_setcap
    echo "==> To run homepod-sink at login:"
    echo "==>   systemctl --user enable --now homepod-sink"
    echo "==> Auto-discovery is used by default (connects if exactly one AirPlay"
    echo "==> device is on the network). To target a specific device instead,"
    echo "==> copy /etc/homepod-sink/homepod-sink.env.example to"
    echo "==> ~/.config/homepod-sink/homepod-sink.env and set HOMEPOD_IP or"
    echo "==> HOMEPOD_NAME. Find its name/IP by running"
    echo "==>   /usr/lib/homepod-sink/homepod-sink"
    echo "==> by hand: it prints the name and IP of the device it connects to,"
    echo "==> or lists every device found if there's more than one."
}

post_upgrade() {
    apply_setcap
}

pre_remove() {
    # This runs as root with no reliable way to identify (or reach) the
    # invoking user's systemd --user session, so it can't safely run
    # `systemctl --user` itself - just tell the user to do it before the
    # binary disappears out from under a still-running service.
    echo "==> If homepod-sink.service is enabled/running, stop it first:"
    echo "==>   systemctl --user disable --now homepod-sink"
}
