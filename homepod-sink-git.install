# These hooks run as root. They reach each logged-in or lingering user's
# systemd --user manager through `systemctl --user -M <user>@`.

_users() {
    loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'
}

_userctl() {
    user=$1
    shift
    systemctl --user -M "$user@" "$@"
}

post_install() {
    for user in $(_users); do
        _userctl "$user" daemon-reload 2>/dev/null
        if _userctl "$user" enable --now homepod-sink 2>/dev/null; then
            echo "==> Enabled and started homepod-sink.service for $user"
        else
            echo "==> Couldn't enable homepod-sink.service for $user, run:"
            echo "==>   systemctl --user enable --now homepod-sink"
        fi
    done
    echo "==> homepod-sink creates a PipeWire virtual sink for every AirPlay 2"
    echo "==> device it finds on the network - pick which one to use from your"
    echo "==> system's audio output picker (e.g. Noctalia), same as any other"
    echo "==> output device. Nothing to configure to select a target."
}

post_upgrade() {
    # Restart wherever it's running, so it picks up the new binary.
    for user in $(_users); do
        _userctl "$user" daemon-reload 2>/dev/null
        _userctl "$user" is-active --quiet homepod-sink 2>/dev/null || continue
        if _userctl "$user" restart homepod-sink; then
            echo "==> Restarted homepod-sink.service for $user"
        else
            echo "==> Couldn't restart homepod-sink.service for $user, run:"
            echo "==>   systemctl --user restart homepod-sink"
        fi
    done
}

pre_remove() {
    # Stop it before the binary disappears out from under a running service.
    for user in $(_users); do
        _userctl "$user" is-enabled --quiet homepod-sink 2>/dev/null ||
            _userctl "$user" is-active --quiet homepod-sink 2>/dev/null ||
            continue
        if _userctl "$user" disable --now homepod-sink; then
            echo "==> Stopped and disabled homepod-sink.service for $user"
        else
            echo "==> Couldn't stop homepod-sink.service for $user, run:"
            echo "==>   systemctl --user disable --now homepod-sink"
        fi
    done
}
